# Backend
DAY_TRADE_MAKER_ENV=development
DATABASE_URL=sqlite:///./day_trade_maker.sqlite3

# LLM provider settings go here later. Do not commit real keys.
LLM_PROVIDER=fake
LLM_API_KEY=

# Interactive Brokers paper defaults
# These DAY_TRADE_MAKER_* variables are the backend's active IBKR settings.
# Keep paper order submission disabled unless you are intentionally testing
# against an IBKR paper account. Live trading is unsupported.
DAY_TRADE_MAKER_IBKR_HOST=127.0.0.1
DAY_TRADE_MAKER_IBKR_PORT=4002
DAY_TRADE_MAKER_IBKR_CLIENT_ID=1
DAY_TRADE_MAKER_IBKR_CONNECTIVITY_PROBE_ENABLED=false
DAY_TRADE_MAKER_IBKR_CONNECTIVITY_PROBE_TIMEOUT_SECONDS=1.0
DAY_TRADE_MAKER_IBKR_ACCOUNT_SNAPSHOT_ENABLED=false
DAY_TRADE_MAKER_IBKR_ACCOUNT_SNAPSHOT_READER=static
# Required only when paper order submission is explicitly enabled.
# Use the IBKR paper account id from the loaded account snapshot, e.g. DU1234567.
DAY_TRADE_MAKER_IBKR_PAPER_ACCOUNT_ID=
DAY_TRADE_MAKER_IBKR_PAPER_ORDER_SUBMISSION_ENABLED=false
DAY_TRADE_MAKER_IBKR_PAPER_ORDER_CONFIRMATION_PHRASE="SUBMIT IBKR PAPER ORDER"

# Optional protection for side-effecting broker endpoints when exposing beyond trusted local dev.
# When required, POST /api/broker/paper-order-submissions and status-refresh require both:
# Authorization: Bearer <DAY_TRADE_MAKER_BROKER_SIDE_EFFECT_ADMIN_TOKEN>
# X-CSRF-Token: <DAY_TRADE_MAKER_BROKER_SIDE_EFFECT_CSRF_TOKEN>
DAY_TRADE_MAKER_BROKER_SIDE_EFFECT_AUTH_REQUIRED=false
DAY_TRADE_MAKER_BROKER_SIDE_EFFECT_ADMIN_TOKEN=
DAY_TRADE_MAKER_BROKER_SIDE_EFFECT_CSRF_TOKEN=
